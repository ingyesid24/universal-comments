---
// docs/src/components/Footer.astro
import { REPO_URL, NPM_URL, SPONSOR_URL } from "../site";
---

<footer class="border-t border-brand-card px-6 py-8 mt-20">
  <div class="mx-auto max-w-7xl flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-white/40">
    <p>
      © {new Date().getFullYear()} universal-comments —
      <a
        href={`${REPO_URL}/blob/main/LICENSE`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/60 hover:text-white transition-colors"
      >MIT License</a>
      ·
      <a href={NPM_URL} target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">npm</a>
      ·
      <a href={SPONSOR_URL} target="_blank" rel="noopener noreferrer" class="text-pink-300 hover:text-white transition-colors">♥ Apoya el proyecto</a>
    </p>
    <p>
      Hecho con
      <a href="https://lit.dev" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">Lit</a>,
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">Astro</a> y
      <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">Tailwind CSS</a>
    </p>
  </div>
</footer>
