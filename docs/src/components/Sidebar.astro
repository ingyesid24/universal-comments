---
// docs/src/components/Sidebar.astro
import { ISSUES_URL, SPONSOR_URL } from "../site";
const links = [
  { href: "/guia-rapida", label: "Guía rápida", external: false },
  { href: "/adaptadores", label: "Adaptadores", external: false },
  { href: "/api", label: "API / Props", external: false },
  { href: "/ejemplos", label: "Ejemplos", external: false },
  { href: "/contribuir", label: "Contribuir", external: false },
  { href: ISSUES_URL, label: "🐛 Reportar bug", external: true },
  { href: SPONSOR_URL, label: "♥ Patrocinar", external: true },
];
---

<aside class="hidden lg:block w-64 shrink-0">
  <nav class="sticky top-20 space-y-1 border-l border-brand-card pl-4">
    <div class="mb-2 border-t border-brand-card pt-3"></div>
    {links.map((link) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class="block py-1.5 text-sm text-white/50 hover:text-white transition-colors"
      >
        {link.label}
      </a>
    ))}
  </nav>
</aside>
