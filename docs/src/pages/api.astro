---
import BaseLayout from "../layouts/BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import CodeBlock from "../components/CodeBlock.astro";

const props = [
  { attr: "max-comments", prop: "maxcomments", type: "number", default: "6", desc: "Cantidad de comentarios visibles antes del botón 'Ver más'." },
  { attr: "placeholder", prop: "placeholder", type: "string", default: `"Escribe un comentario..."`, desc: "Placeholder del textarea." },
  { attr: "theme", prop: "theme", type: `"dark" | "light"`, default: `"dark"`, desc: "Tema del componente." },
  { attr: "char-limit", prop: "charlimit", type: "number", default: "500", desc: "Máximo de caracteres por comentario." },
  { attr: "—", prop: "initialComments", type: "Comment[]", default: "[]", desc: "Array de comentarios iniciales (solo vía JS, no como atributo HTML)." },
];
---

<BaseLayout title="API / Props — universal-comments">
  <div class="fixed inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-blue opacity-[0.08] rounded-full blur-3xl animate-glow-pulse"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-[#8878e6] opacity-[0.06] rounded-full blur-3xl animate-glow-pulse" style="animation-delay: -3s; animation-direction: reverse;"></div>
  </div>
  <div class="mx-auto max-w-7xl px-6 pt-12 pb-20 flex gap-12">
    <Sidebar />
    <article class="min-w-0 flex-1 max-w-3xl">
      <h1 class="text-3xl font-bold mb-2 inline-block bg-linear-to-r from-white via-brand-blue to-white bg-size-[200%_auto] bg-clip-text text-transparent animate-background-shine">API / Props</h1>
      <p class="text-white/50 mb-8">Atributos HTML y propiedades JavaScript del componente.</p>

      <h2 class="text-xl font-semibold mb-4">Atributos HTML</h2>
      <div class="overflow-x-auto rounded-xl border border-brand-card">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-brand-card bg-[#0D1525]">
              <th class="px-4 py-3 text-left font-medium text-white/60">Atributo</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Propiedad</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Tipo</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Default</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Descripción</th>
            </tr>
          </thead>
          <tbody>
            {props.map((p) => (
              <tr class="border-b border-brand-card last:border-0">
                <td class="px-4 py-3 font-mono text-xs text-brand-blue">{p.attr}</td>
                <td class="px-4 py-3 font-mono text-xs text-white/80">{p.prop}</td>
                <td class="px-4 py-3 font-mono text-xs text-white/50">{p.type}</td>
                <td class="px-4 py-3 font-mono text-xs text-white/50">{p.default}</td>
                <td class="px-4 py-3 text-white/70">{p.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-semibold mt-10 mb-4">Propiedades JavaScript</h2>
      <p class="text-white/60 mb-4">Además de los atributos HTML, puedes asignar propiedades directamente desde JavaScript. Los objetos y funciones no se configuran como atributos:</p>

      <div class="overflow-x-auto rounded-xl border border-brand-card mb-6">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-brand-card bg-[#0D1525]">
              <th class="px-4 py-3 text-left font-medium text-white/60">Propiedad</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Tipo</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Descripción</th>
            </tr>
          </thead>
          <tbody>
            {[
              ["initialComments", "Comment[]", "Comentarios iniciales o semilla."],
              ["adapter", "CommentsAdapter | null", "Almacenamiento externo. Al asignarlo se cargan los comentarios."],
              ["author", "{ name: string; avatar?: string }", "Autor usado al publicar. El backend debe validar la identidad."],
              ["messages", "Partial<CommentsMessages>", "Textos de la interfaz. Por defecto, español."],
              ["reload()", "Promise<void>", "Recarga desde el adaptador configurado."],
            ].map(([prop, type, desc]) => (
              <tr class="border-b border-brand-card last:border-0">
                <td class="px-4 py-3 font-mono text-xs text-brand-blue">{prop}</td>
                <td class="px-4 py-3 font-mono text-xs text-white/50">{type}</td>
                <td class="px-4 py-3 text-white/70">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="relative overflow-hidden rounded-xl border border-brand-card p-px backdrop-blur-3xl">
        <span class="absolute inset-[-1000%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,rgba(59,130,246,0.3)_0%,transparent_50%,rgba(59,130,246,0.3)_100%)]" />
        <div class="relative bg-brand-bg rounded-xl">
          <CodeBlock code={`const el = document.querySelector("universal-comments");

el.maxcomments = 9;
el.placeholder = "Tu opinión nos importa...";
el.theme = "light";
el.charlimit = 300;
el.author = { name: "Ana García" };`} lang="js" />
        </div>
      </div>

      <h3 class="text-lg font-semibold mt-8 mb-2">adapter</h3>
      <p class="text-white/60 mb-4">Conecta un almacenamiento propio (memoria, REST o personalizado). Consulta la <a class="text-brand-blue" href="/adaptadores">guía de adaptadores</a>.</p>
      <CodeBlock code={`import { InMemoryCommentsAdapter } from "universal-comments/adapters";

const el = document.querySelector("universal-comments");
el.adapter = new InMemoryCommentsAdapter({ comments: [] });`} lang="js" />

      <h3 class="text-lg font-semibold mt-8 mb-2">messages</h3>
      <p class="text-white/60 mb-4">Sobrescribe los textos que necesites; el resto conserva los valores por defecto:</p>
      <CodeBlock code={`el.messages = {
  title: "Opiniones",
  empty: "Todavía no hay comentarios",
  submit: "Enviar",
  submitting: "Enviando...",
  // Fecha relativa de cada comentario (por defecto en español: "hace 5 minutos")
  timeAgo: (date) =>
    new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(
      Math.round((new Date(date) - Date.now()) / 60000), "minute"),
};`} lang="js" />

      <h3 class="text-lg font-semibold mt-8 mb-2">initialComments</h3>
      <p class="text-white/60 mb-4">Para inicializar con comentarios existentes durante la hidratación en cliente. La propiedad se conserva aunque se asigne antes del upgrade; importar primero el componente sigue siendo el patrón recomendado:</p>
      <CodeBlock code={`el.initialComments = [
  {
    id: "1",
    text: "¡Excelente componente!",
    date: "2025-01-15T10:00:00Z",
    name: "Usuario Ejemplo",
    avatar: "https://i.pravatar.cc/80?u=1",
    emoji: "👍"
  }
];`} lang="js" />

      <h3 class="text-lg font-semibold mt-8 mb-2">Interfaz Comment</h3>
      <div class="relative overflow-hidden rounded-xl border border-brand-card p-px backdrop-blur-3xl">
        <span class="absolute inset-[-1000%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,rgba(136,120,230,0.3)_0%,transparent_50%,rgba(136,120,230,0.3)_100%)]" />
        <div class="relative bg-brand-bg rounded-xl">
          <CodeBlock code={`interface Comment {
  id: string;
  text: string;
  date: string;
  name: string;
  avatar: string;
  emoji: string;
  liked?: boolean;
}`} lang="ts" />
        </div>
      </div>

      <h2 class="text-xl font-semibold mt-10 mb-4">Eventos</h2>
      <p class="text-white/60 mb-4">El componente dispatchea eventos personalizados que puedes escuchar:</p>
      <div class="relative overflow-x-auto rounded-xl border border-brand-card">
        <div class="pointer-events-none absolute top-0 left-0 right-0 flex justify-center">
          <div class="h-px animate-border-width rounded-full bg-linear-to-r from-[rgba(17,17,17,0)] via-brand-blue to-[rgba(17,17,17,0)]"></div>
        </div>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-brand-card bg-[#0D1525]">
              <th class="px-4 py-3 text-left font-medium text-white/60">Evento</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Detalle</th>
              <th class="px-4 py-3 text-left font-medium text-white/60">Descripción</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-brand-card">
              <td class="px-4 py-3 font-mono text-xs text-brand-blue">comment-added</td>
              <td class="px-4 py-3 font-mono text-xs text-white/50"><code>{"{ comment: Comment }"}</code></td>
              <td class="px-4 py-3 text-white/70">Se dispara tras confirmar la creación (con adaptador) o inmediatamente en modo local.</td>
            </tr>
            <tr class="border-b border-brand-card">
              <td class="px-4 py-3 font-mono text-xs text-brand-blue">comment-deleted</td>
              <td class="px-4 py-3 font-mono text-xs text-white/50"><code>{"{ commentId: string }"}</code></td>
              <td class="px-4 py-3 text-white/70">Se dispara tras confirmar y animar la eliminación.</td>
            </tr>
            <tr class="border-b border-brand-card">
              <td class="px-4 py-3 font-mono text-xs text-brand-blue">comments-loaded</td>
              <td class="px-4 py-3 font-mono text-xs text-white/50"><code>{"{ comments: Comment[] }"}</code></td>
              <td class="px-4 py-3 text-white/70">El adaptador terminó de cargar los comentarios.</td>
            </tr>
            <tr class="border-b border-brand-card">
              <td class="px-4 py-3 font-mono text-xs text-brand-blue">comments-error</td>
              <td class="px-4 py-3 font-mono text-xs text-white/50"><code>{"{ operation, error, commentId? }"}</code></td>
              <td class="px-4 py-3 text-white/70">Falló una operación del adaptador. <code>error</code> es <code>CommentsAdapterError</code>.</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-mono text-xs text-brand-blue">comment-reaction-changed</td>
              <td class="px-4 py-3 font-mono text-xs text-white/50"><code>{"{ commentId, emoji }"}</code></td>
              <td class="px-4 py-3 text-white/70">La reacción se persistió correctamente.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-xl font-semibold mt-10 mb-4">Variables CSS y Shadow Parts</h2>
      <p class="text-white/60 mb-3">Personaliza sin romper el diseño base:</p>
      <CodeBlock code={`universal-comments {
  --uc-accent: #3b82f6;
  --uc-accent-strong: #2563eb;
  --uc-accent-strong-hover: #1d4ed8;
  --uc-error: #ef4444;       /* tema oscuro */
  --uc-error-light: #dc2626; /* tema claro */
  --uc-radius: 1rem;
}`} lang="css" />
      <p class="text-white/60 mb-2"><strong class="text-white/80">Parts:</strong> <code>container</code>, <code>title</code>, <code>textarea</code>, <code>char-count</code>, <code>submit</code>, <code>emoji-button</code>, <code>comment-card</code>, <code>avatar</code>, <code>name</code>, <code>time</code>, <code>text</code>, <code>reaction</code>, <code>delete</code>, <code>show-more</code>, <code>empty</code>, <code>error</code>, <code>retry</code>.</p>
      <CodeBlock code={`universal-comments::part(comment-card) {
  border-radius: 0.5rem;
}`} lang="css" />

      <h2 class="text-xl font-semibold mt-10 mb-4">Errores y responsabilidades del backend</h2>
      <p class="text-white/60 mb-2">El componente no reintenta automáticamente y no es un mecanismo de autorización. El backend debe validar y autorizar cada operación.</p>
      <p class="text-white/60">Los errores de almacenamiento se normalizan con <code>CommentsAdapterError</code> (<code>code</code>, <code>status?</code>, <code>retryable</code>). Códigos: <code>network</code>, <code>unauthorized</code>, <code>forbidden</code>, <code>not-found</code>, <code>conflict</code>, <code>validation</code>, <code>rate-limited</code>, <code>timeout</code>, <code>server</code>, <code>aborted</code>, <code>unknown</code>. Consulta la <a class="text-brand-blue" href="/adaptadores">guía de adaptadores</a> para el contrato completo.</p>
    </article>
  </div>
</BaseLayout>
